# Gọi API thật qua proxy của Vite (cùng origin, cookie refresh HttpOnly không cần CORS).
VITE_API_BASE_URL=/api/v1
# Đích của proxy dev /api -> backend NestJS.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Mặc định false = gọi API thật. Đặt true chỉ để dùng mock adapter trong src/mocks (demo/e2e).
VITE_USE_MOCK_API=false
