NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_ENABLED=false
DATABASE_ENVIRONMENT=development
# Neon pooled URL: postgresql://neondb_owner:<password>@<pooled-host>/Apartment?sslmode=require&channel_binding=require
DATABASE_URL=
# Neon direct URL: postgresql://neondb_owner:<password>@<direct-host>/Apartment?sslmode=require&channel_binding=require
DIRECT_URL=

# Auth security core remains disabled until Auth business services are enabled.
AUTH_ENABLED=false
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ACTIVE_KID=
# JSON object: kid -> random secret encoded as canonical base64 (minimum 32 bytes before encoding).
AUTH_JWT_KEYS=
# Development may use a plain name; production must use an __Host- prefixed name.
AUTH_REFRESH_COOKIE_NAME=
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# Explicit reverse-proxy IPs/CIDRs only, comma-separated. Empty = trust no proxy headers.
# Never use true, a hop count, wildcard, or a client-accessible network as a trusted proxy.
TRUSTED_PROXY_CIDRS=
# Process-local fixed-window limiter. Not shared across replicas; restart clears counters.
# Production/distributed readiness requires a shared atomic store (not implemented).
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_REGISTER_IP_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_IP_MAX=30
AUTH_RATE_LIMIT_LOGIN_EMAIL_MAX=10
AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REFRESH_IP_MAX=60
AUTH_RATE_LIMIT_REFRESH_FAMILY_MAX=30
AUTH_RATE_LIMIT_MAX_KEYS=20000

# Forgot/reset password limits (same process-local limiter as above).
AUTH_RATE_LIMIT_FORGOT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_FORGOT_IP_MAX=5
AUTH_RATE_LIMIT_FORGOT_EMAIL_MAX=3
AUTH_RATE_LIMIT_RESET_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_RESET_IP_MAX=10
AUTH_RATE_LIMIT_RESET_TOKEN_MAX=5

# Outgoing e-mail for password reset. EMAIL_PROVIDER=disabled (default) sends nothing and creates
# no reset token. For smtp, SMTP_HOST/SMTP_PORT/EMAIL_FROM/PASSWORD_RESET_URL_BASE are required;
# SMTP_USER and SMTP_PASSWORD go together. Keep real credentials out of Git.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Front-end page that reads the token from the URL fragment (#token=...). Its origin must be in CORS_ORIGINS.
PASSWORD_RESET_URL_BASE=
