{
  "name": "@rental/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --no-experimental-strip-types --require ts-node/register src/main.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pretest": "npm run prisma:generate",
    "test": "jest --runInBand",
    "test:api": "jest --config test/jest-api.config.cjs --runInBand",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:migrate:dev": "node scripts/prisma-database-command.cjs migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-database-command.cjs migrate deploy",
    "prisma:migrate:status": "node scripts/prisma-database-command.cjs migrate status",
    "prisma:inspect": "node scripts/prisma-database-command.cjs db pull --print",
    "prisma:studio": "node scripts/prisma-database-command.cjs studio",
    "prisma:check-neon": "node --require ts-node/register scripts/check-neon.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rental/shared": "0.1.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2"
  }
}
