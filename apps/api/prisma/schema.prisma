generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum AuthSessionRevokeReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE
  USER_DISABLED

  @@map("auth_session_revoke_reason")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash String        @map("password_hash") @db.Text
  displayName  String?       @map("display_name") @db.VarChar(100)
  status       UserStatus    @default(ACTIVE)
  disabledAt   DateTime?     @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     AuthSession[]

  @@map("users")
}

model AuthSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  familyId            String                   @map("family_id") @db.Uuid
  tokenHash           Bytes                    @unique(map: "auth_sessions_token_hash_key") @map("token_hash") @db.ByteA
  parentSessionId     String?                  @unique(map: "auth_sessions_parent_session_id_key") @map("parent_session_id") @db.Uuid
  replacedBySessionId String?                  @unique(map: "auth_sessions_replaced_by_session_id_key") @map("replaced_by_session_id") @db.Uuid
  expiresAt           DateTime                 @map("expires_at") @db.Timestamptz(6)
  lastUsedAt          DateTime?                @map("last_used_at") @db.Timestamptz(6)
  revokedAt           DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokeReason        AuthSessionRevokeReason? @map("revoke_reason")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentSession       AuthSession?             @relation("AuthSessionParent", fields: [parentSessionId], references: [id], onDelete: SetNull)
  childSession        AuthSession?             @relation("AuthSessionParent")
  replacedBySession   AuthSession?             @relation("AuthSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacesSession     AuthSession?             @relation("AuthSessionReplacement")

  @@index([userId, revokedAt], map: "auth_sessions_user_id_revoked_at_idx")
  @@index([familyId, revokedAt], map: "auth_sessions_family_id_revoked_at_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}
