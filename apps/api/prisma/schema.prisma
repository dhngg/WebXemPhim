generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum AuthSessionRevokeReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE
  USER_DISABLED

  @@map("auth_session_revoke_reason")
}

enum WorkspaceRole {
  OWNER
  MANAGER
  STAFF

  @@map("workspace_role")
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED

  @@map("workspace_status")
}

enum BuildingStatus {
  ACTIVE
  ARCHIVED

  @@map("building_status")
}

enum RoomStatus {
  VACANT
  OCCUPIED
  UNAVAILABLE
  ARCHIVED

  @@map("room_status")
}

enum ViewingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("viewing_request_status")
}

enum TenantStatus {
  ACTIVE
  ARCHIVED

  @@map("tenant_status")
}

enum TenantLinkRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("tenant_link_request_status")
}

enum LandlordApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("landlord_application_status")
}

enum ContractStatus {
  ACTIVE
  ENDED

  @@map("contract_status")
}

enum VehicleStatus {
  ACTIVE
  INACTIVE

  @@map("vehicle_status")
}

enum RateServiceType {
  ELECTRICITY
  WATER
  WIFI
  TRASH
  PARKING
  OTHER

  @@map("rate_service_type")
}

enum RateBillingUnit {
  KWH
  CUBIC_METER
  ROOM
  PERSON
  VEHICLE
  FIXED

  @@map("rate_billing_unit")
}

enum RatePlanStatus {
  ACTIVE
  INACTIVE

  @@map("rate_plan_status")
}

model User {
  id                          String                @id @default(uuid()) @db.Uuid
  email                       String                @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash                String                @map("password_hash") @db.Text
  displayName                 String?               @map("display_name") @db.VarChar(100)
  status                      UserStatus            @default(ACTIVE)
  disabledAt                  DateTime?             @map("disabled_at") @db.Timestamptz(6)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions                    AuthSession[]
  memberships                 WorkspaceMembership[]
  viewingRequests             ViewingRequest[]      @relation("ViewingRequester")
  viewingDecisions            ViewingRequest[]      @relation("ViewingDecider")
  tenantLinkRequests          TenantLinkRequest[]   @relation("TenantLinkRequester")
  tenantLinkDecisions         TenantLinkRequest[]   @relation("TenantLinkDecider")
  tenantLinks                 TenantUserLink[]      @relation("TenantLinkedUser")
  tenantLinkApprovals         TenantUserLink[]      @relation("TenantLinkApprover")
  tenantLinkRevocations       TenantUserLink[]      @relation("TenantLinkRevoker")
  contractsCreated            Contract[]            @relation("ContractCreator")
  contractsEnded              Contract[]            @relation("ContractEnder")
  notifications               Notification[]
  platformAdmin               PlatformAdmin?
  passwordResetTokens         PasswordResetToken[]
  adminAuditLogs              AdminAuditLog[]
  listingModerations          ListingModeration[]
  landlordApplications        LandlordApplication[]
  decidedLandlordApplications LandlordApplication[] @relation("LandlordApplicationDecider")
  tenantInvitationsCreated    TenantInvitation[]    @relation("TenantInvitationCreator")
  tenantInvitationsAccepted   TenantInvitation[]    @relation("TenantInvitationAccepter")

  @@map("users")
}

model Workspace {
  id                     String                     @id @default(uuid()) @db.Uuid
  name                   String                     @db.VarChar(100)
  status                 WorkspaceStatus            @default(ACTIVE)
  archivedAt             DateTime?                  @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships            WorkspaceMembership[]
  buildings              Building[]
  rooms                  Room[]
  amenities              Amenity[]
  roomImages             RoomImage[]
  listings               Listing[]
  viewingRequests        ViewingRequest[]
  tenants                Tenant[]
  tenantLinkRequests     TenantLinkRequest[]
  tenantUserLinks        TenantUserLink[]
  tenantInvitations      TenantInvitation[]
  contracts              Contract[]
  vehicles               Vehicle[]
  ratePlans              RatePlan[]
  meterReadings          MeterReading[]
  meterAdjustments       MeterReadingAdjustment[]
  invoiceItems           InvoiceItem[]
  invoices               Invoice[]
  roomServiceAssignments RoomServiceAssignment[]
  invoiceAdjustments     InvoiceAdjustment[]
  invoicePayments        InvoicePayment[]
  contractDepositEntries ContractDepositEntry[]
  maintenanceRequests    MaintenanceRequest[]
  maintenanceHistory     MaintenanceStatusHistory[]
  notifications          Notification[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId], map: "workspace_memberships_workspace_id_user_id_key")
  @@index([userId], map: "workspace_memberships_user_id_idx")
  @@index([workspaceId, role], map: "workspace_memberships_workspace_id_role_idx")
  @@map("workspace_memberships")
}

model Building {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  name         String         @db.VarChar(100)
  description  String?        @db.Text
  status       BuildingStatus @default(ACTIVE)
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz(6)
  addressLine1 String         @map("address_line_1") @db.VarChar(200)
  addressLine2 String?        @map("address_line_2") @db.VarChar(200)
  ward         String?        @db.VarChar(100)
  district     String?        @db.VarChar(100)
  city         String         @db.VarChar(100)
  postalCode   String?        @map("postal_code") @db.VarChar(20)
  countryCode  String         @default("VN") @map("country_code") @db.Char(2)
  latitude     Decimal?       @db.Decimal(9, 6)
  longitude    Decimal?       @db.Decimal(10, 6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  rooms        Room[]
  ratePlans    RatePlan[]

  @@unique([id, workspaceId], map: "buildings_id_workspace_id_key")
  @@index([workspaceId], map: "buildings_workspace_id_idx")
  @@index([workspaceId, city, district], map: "buildings_workspace_id_city_district_idx")
  @@map("buildings")
}

model Room {
  id                  String                  @id @default(uuid()) @db.Uuid
  workspaceId         String                  @map("workspace_id") @db.Uuid
  buildingId          String                  @map("building_id") @db.Uuid
  code                String                  @db.VarChar(50)
  areaSqm             Decimal                 @map("area_sqm") @db.Decimal(10, 2)
  monthlyRent         Decimal                 @map("monthly_rent") @db.Decimal(14, 2)
  maxOccupants        Int                     @default(1) @map("max_occupants")
  description         String?                 @db.Text
  status              RoomStatus              @default(VACANT)
  archivedAt          DateTime?               @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  building            Building                @relation(fields: [buildingId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  amenities           RoomAmenity[]
  images              RoomImage[]
  listing             Listing?
  contracts           Contract[]
  meterReadings       MeterReading[]
  invoices            Invoice[]
  serviceAssignments  RoomServiceAssignment[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([id, workspaceId], map: "rooms_id_workspace_id_key")
  @@unique([id, buildingId, workspaceId], map: "rooms_id_building_id_workspace_id_key")
  @@unique([buildingId, code], map: "rooms_building_id_code_key")
  @@index([workspaceId, status], map: "rooms_workspace_id_status_idx")
  @@index([buildingId, status], map: "rooms_building_id_status_idx")
  @@map("rooms")
}

model RoomImage {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  url         String    @db.VarChar(2048)
  altText     String?   @map("alt_text") @db.VarChar(200)
  sortOrder   Int       @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  room        Room      @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId], map: "room_images_workspace_id_idx")
  @@index([roomId, sortOrder, id], map: "room_images_room_id_sort_order_id_idx")
  @@map("room_images")
}

model Listing {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  roomId          String             @unique(map: "listings_room_id_key") @map("room_id") @db.Uuid
  isPublished     Boolean            @default(false) @map("is_published")
  publishedAt     DateTime?          @map("published_at") @db.Timestamptz(6)
  unpublishedAt   DateTime?          @map("unpublished_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  room            Room               @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  viewingRequests ViewingRequest[]
  moderation      ListingModeration?

  @@unique([id, workspaceId], map: "listings_id_workspace_id_key")
  @@unique([roomId, workspaceId], map: "listings_room_id_workspace_id_key")
  @@index([workspaceId], map: "listings_workspace_id_idx")
  @@index([isPublished, publishedAt, id], map: "listings_publication_idx")
  @@map("listings")
}

model ViewingRequest {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  listingId       String               @map("listing_id") @db.Uuid
  requesterUserId String               @map("requester_user_id") @db.Uuid
  scheduledAt     DateTime             @map("scheduled_at") @db.Timestamptz(6)
  message         String?              @db.VarChar(1000)
  status          ViewingRequestStatus @default(PENDING)
  decisionNote    String?              @map("decision_note") @db.VarChar(1000)
  decidedByUserId String?              @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz(6)
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  listing         Listing              @relation(fields: [listingId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  requester       User                 @relation("ViewingRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  decidedBy       User?                @relation("ViewingDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([requesterUserId, status, scheduledAt], map: "viewing_requests_requester_status_scheduled_idx")
  @@index([workspaceId, status, scheduledAt], map: "viewing_requests_workspace_status_scheduled_idx")
  @@index([listingId, scheduledAt], map: "viewing_requests_listing_scheduled_idx")
  @@map("viewing_requests")
}

model Tenant {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  fullName     String              @map("full_name") @db.VarChar(150)
  phone        String?             @db.VarChar(20)
  email        String?             @db.VarChar(254)
  dateOfBirth  DateTime?           @map("date_of_birth") @db.Date
  address      String?             @db.VarChar(500)
  notes        String?             @db.Text
  status       TenantStatus        @default(ACTIVE)
  archivedAt   DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  linkRequests TenantLinkRequest[]
  userLinks    TenantUserLink[]
  invitations  TenantInvitation[]
  contracts    Contract[]
  vehicles     Vehicle[]

  @@unique([id, workspaceId], map: "tenants_id_workspace_id_key")
  @@index([workspaceId, status, fullName], map: "tenants_workspace_status_full_name_idx")
  @@index([workspaceId, phone], map: "tenants_workspace_phone_idx")
  @@index([workspaceId, email], map: "tenants_workspace_email_idx")
  @@map("tenants")
}

model TenantLinkRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  requesterUserId String                  @map("requester_user_id") @db.Uuid
  status          TenantLinkRequestStatus @default(PENDING)
  message         String?                 @db.VarChar(500)
  decisionNote    String?                 @map("decision_note") @db.VarChar(500)
  decidedByUserId String?                 @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?               @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tenant          Tenant                  @relation(fields: [tenantId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  requester       User                    @relation("TenantLinkRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  decidedBy       User?                   @relation("TenantLinkDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  approvedLink    TenantUserLink?

  @@index([requesterUserId, status, createdAt], map: "tenant_link_requests_requester_status_created_idx")
  @@index([workspaceId, status, createdAt], map: "tenant_link_requests_workspace_status_created_idx")
  @@index([tenantId, status], map: "tenant_link_requests_tenant_status_idx")
  @@map("tenant_link_requests")
}

model TenantUserLink {
  id               String             @id @default(uuid()) @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  linkRequestId    String?            @unique(map: "tenant_user_links_link_request_id_key") @map("link_request_id") @db.Uuid
  invitationId     String?            @unique(map: "tenant_user_links_invitation_id_key") @map("invitation_id") @db.Uuid
  approvedByUserId String             @map("approved_by_user_id") @db.Uuid
  linkedAt         DateTime           @default(now()) @map("linked_at") @db.Timestamptz(6)
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId  String?            @map("revoked_by_user_id") @db.Uuid
  revokeReason     String?            @map("revoke_reason") @db.VarChar(500)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tenant           Tenant             @relation(fields: [tenantId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  user             User               @relation("TenantLinkedUser", fields: [userId], references: [id], onDelete: Restrict)
  linkRequest      TenantLinkRequest? @relation(fields: [linkRequestId], references: [id], onDelete: Restrict)
  invitation       TenantInvitation?  @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  approvedBy       User               @relation("TenantLinkApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  revokedBy        User?              @relation("TenantLinkRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt], map: "tenant_user_links_user_revoked_idx")
  @@index([workspaceId, revokedAt], map: "tenant_user_links_workspace_revoked_idx")
  @@index([tenantId, revokedAt], map: "tenant_user_links_tenant_revoked_idx")
  @@map("tenant_user_links")
}

model TenantInvitation {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  tokenHash        Bytes           @unique(map: "tenant_invitations_token_hash_key") @map("token_hash") @db.ByteA
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?       @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?         @map("accepted_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tenant           Tenant          @relation(fields: [tenantId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy        User            @relation("TenantInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?           @relation("TenantInvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  createdLink      TenantUserLink?

  @@index([tenantId, expiresAt])
  @@index([acceptedByUserId, acceptedAt])
  @@map("tenant_invitations")
}

model LandlordApplication {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @map("user_id") @db.Uuid
  status             LandlordApplicationStatus @default(PENDING)
  reason             String                    @db.VarChar(1000)
  decisionNote       String?                   @map("decision_note") @db.VarChar(1000)
  decidedByUserId    String?                   @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?                 @map("decided_at") @db.Timestamptz(6)
  workspaceCreatedAt DateTime?                 @map("workspace_created_at") @db.Timestamptz(6)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  decidedBy          User?                     @relation("LandlordApplicationDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("landlord_applications")
}

model Contract {
  id                  String                 @id @default(uuid()) @db.Uuid
  workspaceId         String                 @map("workspace_id") @db.Uuid
  roomId              String                 @map("room_id") @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  startDate           DateTime               @map("start_date") @db.Date
  endDate             DateTime               @map("end_date") @db.Date
  monthlyRent         Decimal                @map("monthly_rent") @db.Decimal(14, 2)
  status              ContractStatus         @default(ACTIVE)
  notes               String?                @db.Text
  createdByUserId     String                 @map("created_by_user_id") @db.Uuid
  endedByUserId       String?                @map("ended_by_user_id") @db.Uuid
  endedAt             DateTime?              @map("ended_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  room                Room                   @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  tenant              Tenant                 @relation(fields: [tenantId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy           User                   @relation("ContractCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  endedBy             User?                  @relation("ContractEnder", fields: [endedByUserId], references: [id], onDelete: Restrict)
  invoices            Invoice[]
  depositEntries      ContractDepositEntry[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([id, roomId, tenantId, workspaceId], map: "contracts_id_room_id_tenant_id_workspace_id_key")
  @@unique([id, workspaceId], map: "contracts_id_workspace_id_key")
  @@index([workspaceId, status, startDate], map: "contracts_workspace_status_start_idx")
  @@index([roomId, status, startDate, endDate], map: "contracts_room_status_period_idx")
  @@index([tenantId, status, startDate], map: "contracts_tenant_status_start_idx")
  @@map("contracts")
}

model Vehicle {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  licensePlate   String        @map("license_plate") @db.VarChar(20)
  vehicleType    String        @map("vehicle_type") @db.VarChar(50)
  brand          String?       @db.VarChar(100)
  model          String?       @db.VarChar(100)
  color          String?       @db.VarChar(50)
  notes          String?       @db.Text
  status         VehicleStatus @default(ACTIVE)
  inactiveAt     DateTime?     @map("inactive_at") @db.Timestamptz(6)
  inactiveReason String?       @map("inactive_reason") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tenant         Tenant        @relation(fields: [tenantId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, licensePlate], map: "vehicles_workspace_license_plate_key")
  @@index([workspaceId, status, createdAt], map: "vehicles_workspace_status_created_idx")
  @@index([tenantId, status], map: "vehicles_tenant_status_idx")
  @@map("vehicles")
}

model RatePlan {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  buildingId    String          @map("building_id") @db.Uuid
  code          String          @db.VarChar(50)
  name          String          @db.VarChar(100)
  serviceType   RateServiceType @map("service_type")
  billingUnit   RateBillingUnit @map("billing_unit")
  unitPrice     Decimal         @map("unit_price") @db.Decimal(14, 4)
  effectiveFrom DateTime        @map("effective_from") @db.Date
  effectiveTo   DateTime?       @map("effective_to") @db.Date
  status        RatePlanStatus  @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
