# Có thể sao chép thành .env ở root. apps/api/.env được ưu tiên nếu cả hai cùng tồn tại.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scaffold và CI chạy không cần database.
DATABASE_ENABLED=false
DATABASE_ENVIRONMENT=development
# Pooled URL cho Prisma Client runtime. Không commit giá trị thật.
DATABASE_URL=
# Direct URL cho Prisma CLI, introspection và migrations. Không commit giá trị thật.
DIRECT_URL=

# Chỉ đặt cấu hình frontend công khai trong apps/web/.env.
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000
