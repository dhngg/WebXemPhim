# Có thể sao chép thành .env ở root. apps/api/.env được ưu tiên nếu cả hai cùng tồn tại.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scaffold và CI chạy không cần database.
DATABASE_ENABLED=false
DATABASE_ENVIRONMENT=development
# Pooled URL cho Prisma Client runtime. Không commit giá trị thật.
DATABASE_URL=
# Direct URL cho Prisma CLI, introspection và migrations. Không commit giá trị thật.
DIRECT_URL=

# Auth security core. Keep disabled until all values are supplied by the environment/secret manager.
AUTH_ENABLED=false
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ACTIVE_KID=
# JSON object: kid -> random secret encoded as canonical base64 (minimum 32 bytes before encoding).
AUTH_JWT_KEYS=
# Development may use a plain name; production must use an __Host- prefixed name.
AUTH_REFRESH_COOKIE_NAME=
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# Explicit reverse-proxy IPs/CIDRs only, comma-separated. Empty = trust no proxy headers.
# Never use true, a hop count, wildcard, or a client-accessible network as a trusted proxy.
TRUSTED_PROXY_CIDRS=
# Process-local fixed-window limiter. Not shared across replicas; restart clears counters.
# Production/distributed readiness requires a shared atomic store (not implemented).
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_REGISTER_IP_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_IP_MAX=30
AUTH_RATE_LIMIT_LOGIN_EMAIL_MAX=10
AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REFRESH_IP_MAX=60
AUTH_RATE_LIMIT_REFRESH_FAMILY_MAX=30
AUTH_RATE_LIMIT_MAX_KEYS=20000

# Chỉ đặt cấu hình frontend công khai trong apps/web/.env.
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000
